  "members": {
    "_applyIcon": {
      "jsdoc": {
        "raw": [
          "_applyIcon(value, old) {",
          "      var btn = this.getChildControl(\"button\");",
          "      if (value) {",
          "        btn.setIcon(value);",
          "        btn._showChildControl(\"icon\");",
          "      } else {",
          "        btn._excludeChildControl(\"icon\");",
          "      }",
          "    },"
        ]
      },
