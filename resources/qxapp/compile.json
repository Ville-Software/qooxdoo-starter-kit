{
  "$schema": "https://qooxdoo.org/schema/compile-1-0-0.json",
  "targets": [
    {
      "type": "source",
      "outputPath": "../../public/compiled/source",
      "bundle": {
        "include": "qx.*"
      }
    },
    {
      "type": "build",
      "outputPath": "../../public/compiled/build"
    }
  ],
  "defaultTarget": "source",
  "locales": ["en"],
  "environment": {
    "qx.nativeScrollBars": true,
    "qx.dyntheme": false
  },
  "babel" : {
    "options" : {
      "targets" : "> 2%, not dead"
    }
  },
  "applications": [
    {
      "class": "qxapp.Application",
      "theme": "ville.cssuc.theme.middleman.Theme",
      "name": "qxapp",
      "bootPath": "source/boot",
      "include": ["qxapp.pages.*"],
      "environment": {
        "inertia.rootView": "app"
      },
      "parts": {
        "boot": {
            "include": [
                "qxapp.Application",
                "qxapp.pages.MPage",
                "ville.cssuc.MCssUtilityClass",
                "ville.cssuc.theme.middleman.*"
            ]
        },
        "Welcome": {
            "include": [
                "qxapp.pages.Welcome"
            ]
        },
        "Dashboard": {
            "include": [
                "qxapp.pages.Dashboard"
            ]
        },
        "app.AppShell": {
            "include": [
                "qxapp.pages.app.AppShell"
            ]
        },
        "auth.Login": {
            "include": [
                "qxapp.pages.auth.Login"
            ]
        },
        "auth.Register": {
            "include": [
                "qxapp.pages.auth.Register"
            ]
        },
        "auth.ForgotPassword": {
            "include": [
                "qxapp.pages.auth.ForgotPassword"
            ]
        },
        "auth.ConfirmPassword": {
            "include": [
                "qxapp.pages.auth.ConfirmPassword"
            ]
        },
        "app.SettingsView": {
            "include": [
                "qxapp.pages.app.SettingsView",
                "qxapp.pages.settings.*"
            ]
        }
      }
    }
  ]
}
